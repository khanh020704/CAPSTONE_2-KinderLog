    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.7.9",
    "multer": "^2.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "msnodesqlv8": "^5.6.0"
  }
}
