PORT=3000

# Local server:  mongodb://localhost:27017
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=kinderlog

# Signs the access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_SECONDS=3600

# Turns a teacher's spoken report into a journal draft with an LLM. Set the key of one provider:
# Groq (default model openai/gpt-oss-120b) or Anthropic (default model claude-opus-5-5).
# Without a key the built-in keyword classifier is used instead.
GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# JOURNAL_AI_PROVIDER=groq      # groq | claude, when both keys are set
# JOURNAL_AI_MODEL=             # overrides the provider's default model
# JOURNAL_DRAFT_ENGINE=ai       # ai | keywords, to force one

# Where the frontend runs; used in the password reset link.
FRONTEND_URL=http://localhost:5173

# Address of this server as browsers see it; used in the addresses of uploaded files.
# PUBLIC_URL=http://localhost:3000

# Origins allowed to call the API from a browser, comma-separated.
CORS_ORIGIN=http://localhost:5173
