# ---------- App ----------
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma-separated origins allowed by CORS (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
# IANA timezone used for "today" and camera viewing windows
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ---------- SQL Server ----------
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
# Also used as the SA password of the Docker container (SQL Server password policy applies)
DB_PASSWORD=KinderLog@2026
DB_NAME=kinderlog
# Never enable in production: use migrations instead
DB_SYNC=false
DB_LOGGING=false

# ---------- Redis (dashboard cache; the API keeps working without it) ----------
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60

# ---------- Auth ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10
# Initial password of accounts created or reset by an admin / principal (users should change it after signing in)
DEFAULT_PASSWORD=123456

# ---------- First System Admin (npm run db:seed:admin / npm run db:clean) ----------
# Created only when no System Admin exists. Sign in with ADMIN_PHONE, then change the password in My Profile.
ADMIN_PHONE=0900000000
# At least 10 characters with letters and digits
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator
ADMIN_EMAIL=

# ---------- Uploads ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# ---------- AI pipeline (Voice -> Whisper ASR -> teacher checks the text -> LLM -> JSON) ----------
# live : Groq (Whisper large-v3 + gpt-oss-120b) when GROQ_API_KEY is set; otherwise OpenAI Whisper and/or
#        Claude when their keys are set. Without an LLM key the draft is made by the built-in keyword rules;
#        without a speech-to-text key the browser's own transcript is used (Chrome/Edge).
# mock : offline rule-based extractor and a scripted transcript, used by the automated tests only
AI_MODE=live
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GROQ_LLM_MODEL=openai/gpt-oss-120b
# Tried in order when the main model reaches a Groq rate limit
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
# groq | claude | keywords (empty = the first provider with a key, else keywords)
JOURNAL_AI_PROVIDER=
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=vi
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
