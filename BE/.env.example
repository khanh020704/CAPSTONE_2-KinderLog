# ---------- App ----------
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma-separated origins allowed by CORS (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
# IANA timezone used for "today" and camera viewing windows
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=kinderlog
DB_PASSWORD=kinderlog
DB_NAME=kinderlog
# Never enable in production: use migrations instead
DB_SYNC=false
DB_LOGGING=false

# ---------- Redis (dashboard cache; the API keeps working without it) ----------
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60

# ---------- Auth ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10
# Initial password for seeded / reset accounts (matches the FE demo)
DEFAULT_PASSWORD=123456

# ---------- Uploads ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# ---------- AI pipeline (Voice -> Whisper ASR -> LLM -> JSON) ----------
# mock   : offline rule-based extractor, no API keys needed (default for demo)
# live   : OpenAI Whisper for speech-to-text + Claude for structured extraction
AI_MODE=mock
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=vi
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
