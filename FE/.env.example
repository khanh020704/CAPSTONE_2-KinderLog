# Where the Vite dev proxy forwards /api and /uploads (the NestJS backend in ../BE)
VITE_BACKEND_URL=http://localhost:3000

# Base URL the browser calls. Keep "/api" in dev (goes through the proxy);
# set the full URL (e.g. https://api.example.com/api) for a production build.
VITE_API_URL=/api

# Initial password of accounts created / reset by the school, shown in form hints.
# Must equal DEFAULT_PASSWORD in BE/.env.
VITE_INITIAL_PASSWORD=123456
